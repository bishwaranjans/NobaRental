{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "NobaRentalBackendApi": {
    "BaseUri": "https+http://nobarental-backendapi"
  },
  "ReverseProxy": {
    "Routes": {
      "weather": {
        "ClusterId": "nobarental-backendapi",
        "Match": {
          "Path": "/weatherforecast/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "nobarental-backendapi": {
        "Destinations": {
          "nobarental-backendapi": {
            "Address": "https+http://nobarental-backendapi"
          }
        }
      }
    }
  }
}
